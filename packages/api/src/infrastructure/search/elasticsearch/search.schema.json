			"tokenizer": {
				"ja_sudachi_tokenizer": {
					"type": "sudachi_tokenizer",
					"split_mode": "C",
					"discard_punctuation": true
				}
			},
			"filter": {
				"sudachi_split_search": {
					"type": "sudachi_split",
					"mode": "search"
				},
				"sudachi_split_extended": {
					"type": "sudachi_split",
					"mode": "extended"
				},
				"sudachi_reading_katakana": {
					"type": "sudachi_readingform",
					"reading_form_type": "surface"
				},
				"sudachi_pos_filter": {
					"type": "sudachi_part_of_speech",
					"stoptags": [
						"助詞",
						"助動詞",
						"記号,一般",
						"記号,読点",
						"記号,句点",
						"記号,空白",
						"補助記号,一般",
						"補助記号,句点",
						"補助記号,読点"
					]
				},
				"sudachi_ja_stop": {
					"type": "stop",
					"stopwords": "_japanese_"
				},
				"sudachi_normalizeform": {
					"type": "sudachi_normalizedform"
				},
				"sudachi_baseform": {
					"type": "sudachi_baseform"
				},
				"katakana_to_hiragana": {
					"type": "icu_transform",
					"id": "Katakana-Hiragana"
				}
			},
			"analyzer": {
				"ja_surface_index_analyzer": {
					"type": "custom",
					"char_filter": ["normalize"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": ["sudachi_pos_filter", "sudachi_split_search", "lowercase"]
				},
				"ja_surface_search_analyzer": {
					"type": "custom",
					"char_filter": ["normalize"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": ["sudachi_pos_filter", "lowercase"]
				},
				"ja_baseform_index_analyzer": {
					"type": "custom",
					"char_filter": ["normalize"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": [
						"sudachi_pos_filter",
						"sudachi_baseform",
						"sudachi_split_search",
						"lowercase"
					]
				},
				"ja_baseform_search_analyzer": {
					"type": "custom",
					"char_filter": ["normalize"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": ["sudachi_pos_filter", "sudachi_baseform", "lowercase"]
				},
				"ja_normalized_index_analyzer": {
					"type": "custom",
					"char_filter": ["normalize"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": [
						"sudachi_pos_filter",
						"sudachi_normalizeform",
						"sudachi_split_search",
						"lowercase"
					]
				},
				"ja_normalized_search_analyzer": {
					"type": "custom",
					"char_filter": ["normalize"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": ["sudachi_pos_filter", "sudachi_normalizeform", "lowercase"]
				},
				"ja_kana_index_analyzer": {
					"type": "custom",
					"char_filter": ["normalize", "romaji_to_kana"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": [
						"sudachi_pos_filter",
						"sudachi_reading_katakana",
						"katakana_to_hiragana",
						"sudachi_split_search",
						"lowercase"
					]
				},
				"ja_kana_search_analyzer": {
					"type": "custom",
					"char_filter": ["normalize", "romaji_to_kana"],
					"tokenizer": "ja_sudachi_tokenizer",
					"filter": [
						"sudachi_pos_filter",
						"sudachi_reading_katakana",
						"katakana_to_hiragana",
						"lowercase"
					]
				}
			}
		}
	},
	"mappings": {
		"properties": {
			"id": { "type": "keyword" },
			"uuid": { "type": "keyword" },
			"serverId": { "type": "keyword" },
			"libraryId": { "type": "long" },
			"filename": { "type": "keyword" },
			"title": {
				"type": "text",
				"analyzer": "ja_surface_index_analyzer",
				"search_analyzer": "ja_surface_search_analyzer",
				"fields": {
					"keyword": { "type": "keyword" },
					"baseform": {
						"type": "text",
						"analyzer": "ja_baseform_index_analyzer",
						"search_analyzer": "ja_baseform_search_analyzer"
					},
					"normalized": {
						"type": "text",
						"analyzer": "ja_normalized_index_analyzer",
						"search_analyzer": "ja_normalized_search_analyzer"
					},
					"kana": {
						"type": "text",
						"analyzer": "ja_kana_index_analyzer",
						"search_analyzer": "ja_kana_search_analyzer"
					}
				}
			},
			"titleRomaji": {
				"type": "text",
				"analyzer": "standard",
				"fields": {
					"keyword": { "type": "keyword" }
				}
			},
			"subtitle": {
				"type": "text",
				"analyzer": "ja_surface_index_analyzer",
				"search_analyzer": "ja_surface_search_analyzer"
			},
			"description": {
				"type": "text",
				"analyzer": "ja_surface_index_analyzer",
				"search_analyzer": "ja_surface_search_analyzer"
			},
			"authors": {
				"type": "nested",
				"properties": {
					"id": { "type": "long" },
					"name": {
						"type": "text",
						"analyzer": "ja_surface_index_analyzer",
						"search_analyzer": "ja_surface_search_analyzer",
						"fields": {
							"keyword": { "type": "keyword" },
							"baseform": {
								"type": "text",
								"analyzer": "ja_baseform_index_analyzer",
								"search_analyzer": "ja_baseform_search_analyzer"
							},
							"normalized": {
								"type": "text",
								"analyzer": "ja_normalized_index_analyzer",
								"search_analyzer": "ja_normalized_search_analyzer"
							},
							"kana": {
								"type": "text",
								"analyzer": "ja_kana_index_analyzer",
								"search_analyzer": "ja_kana_search_analyzer"
							}
						}
					},
					"role": { "type": "keyword" }
				}
			},
			"publisher": {
				"properties": {
					"name": {
						"type": "text",
						"analyzer": "ja_surface_index_analyzer",
						"search_analyzer": "ja_surface_search_analyzer",
						"fields": {
							"keyword": { "type": "keyword" }
						}
					}
				}
			},
			"series": {
				"properties": {
					"name": {
						"type": "text",
						"analyzer": "ja_surface_index_analyzer",
						"search_analyzer": "ja_surface_search_analyzer",
						"fields": {
							"keyword": { "type": "keyword" }
						}
					},
					"aliases": {
						"type": "text",
						"analyzer": "ja_surface_index_analyzer",
						"search_analyzer": "ja_surface_search_analyzer",
						"fields": {
							"keyword": { "type": "keyword" }
						}
					}
				}
			},
			"languageCode": { "type": "keyword" },
			"publishedDate": {
				"type": "date",
				"format": "yyyy-MM-dd||yyyy-MM||yyyy||epoch_millis"
			},
			"pageCount": { "type": "integer" },
			"seriesPosition": { "type": "double" },
			"titleVolume": { "type": "double" },
			"isbn10": { "type": "keyword" },
			"isbn13": { "type": "keyword" },
			"asin": { "type": "keyword" },
			"filesizeKb": { "type": "integer" },
			"amazonRating": { "type": "float" },
			"amazonReviewCount": { "type": "integer" },
			"createdAt": { "type": "date" },
			"lastModified": { "type": "date" }
		}
	}
}
