{
	"name": "nanahoshi",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.6.5",
			"typescript": "^7.0.2",
			"@types/bun": "^1.4.0",
			"hono": "^4.13.8",
			"@orpc/server": "^1.15.1",
			"@orpc/openapi": "^1.15.1",
			"@orpc/zod": "^1.15.1",
			"better-auth": "^1.7.5",
			"@orpc/client": "^1.15.1",
			"drizzle-orm": "^0.45.2",
			"@types/pg": "^8.20.3"
		}
	},
	"type": "module",
	"scripts": {
		"prepare": "if [ -f scripts/setup-hooks.sh ]; then sh scripts/setup-hooks.sh; fi",
		"dev": "turbo dev dev:worker",
		"build": "turbo build",
		"generate": "bun run --cwd apps/web generate",
		"check-types": "bun run generate && turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev dev:worker",
		"db:push": "turbo -F @nanahoshi/db db:push",
		"db:studio": "turbo -F @nanahoshi/db db:studio",
		"db:generate": "turbo -F @nanahoshi/db db:generate",
		"db:migrate": "turbo -F @nanahoshi/db db:migrate",
		"db:start": "turbo -F @nanahoshi/db db:start",
		"db:watch": "turbo -F @nanahoshi/db db:watch",
		"db:stop": "turbo -F @nanahoshi/db db:stop",
		"db:down": "turbo -F @nanahoshi/db db:down",
		"recs:evaluate": "cd apps/server && bun run ../../packages/api/scripts/recs-offline-evaluate.ts",
		"scan:benchmark": "bun run packages/api/scripts/scan-processing-benchmark.ts",
		"scan:acceptance": "bun run packages/api/scripts/scan-acceptance.ts",
		"backend:baseline": "bun run scripts/backend-resource-baseline.ts",
		"infra:up": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env up -d",
		"infra:down": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env down",
		"infra:logs": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env logs -f",
		"backup": "bash scripts/backup.sh",
		"restore": "bash scripts/restore.sh",
		"check": "biome check --write .",
		"test": "bun run generate && bash scripts/test.sh",
		"test:integration": "bash scripts/test-integration.sh",
		"test:containers": "bash scripts/ci-container-smoke.sh",
		"validate": "bun run generate && turbo check-types && bunx biome check . && bash scripts/test.sh"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@nanahoshi/config": "workspace:*",
		"@types/bun": "^1.4.2",
		"playwright-core": "^1.63.0",
		"turbo": "^2.10.13",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"adm-zip": "0.6.0",
		"esbuild": "0.28.2",
		"sharp": "0.35.4"
	},
	"packageManager": "bun@1.4.2",
	"dependencies": {
		"posthog-js": "^1.433.10",
		"posthog-node": "^5.52.4"
	}
}
