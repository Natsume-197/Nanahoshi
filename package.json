{
	"name": "nanahoshi-v2",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^7.0.2",
			"@types/bun": "^1.3.14",
			"hono": "^4.12.33",
			"@orpc/server": "^1.14.13",
			"@orpc/openapi": "^1.14.13",
			"@orpc/zod": "^1.14.13",
			"better-auth": "^1.6.25",
			"@orpc/client": "^1.14.13",
			"drizzle-orm": "^0.45.2",
			"@types/pg": "^8.20.3"
		}
	},
	"type": "module",
	"scripts": {
		"prepare": "if [ -f scripts/setup-hooks.sh ]; then sh scripts/setup-hooks.sh; fi",
		"dev": "turbo dev dev:worker",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev dev:worker",
		"db:push": "turbo -F @nanahoshi-v2/db db:push",
		"db:studio": "turbo -F @nanahoshi-v2/db db:studio",
		"db:generate": "turbo -F @nanahoshi-v2/db db:generate",
		"db:migrate": "turbo -F @nanahoshi-v2/db db:migrate",
		"db:start": "turbo -F @nanahoshi-v2/db db:start",
		"db:watch": "turbo -F @nanahoshi-v2/db db:watch",
		"db:stop": "turbo -F @nanahoshi-v2/db db:stop",
		"db:down": "turbo -F @nanahoshi-v2/db db:down",
		"recs:evaluate": "cd apps/server && bun run ../../packages/api/scripts/recs-offline-evaluate.ts",
		"scan:benchmark": "bun run packages/api/scripts/scan-processing-benchmark.ts",
		"scan:acceptance": "bun run packages/api/scripts/scan-acceptance.ts",
		"backend:baseline": "bun run scripts/backend-resource-baseline.ts",
		"infra:up": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env up -d",
		"infra:down": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env down",
		"infra:logs": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env logs -f",
		"check": "biome check --write .",
		"test": "bash scripts/test.sh",
		"validate": "bun run check-types && bunx biome check . && bun run test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@nanahoshi-v2/config": "workspace:*",
		"@types/bun": "^1.3.14",
		"playwright-core": "^1.62.1",
		"turbo": "^2.10.8",
		"typescript": "^7.0.2"
	},
	"overrides": {
		"ioredis": "6.0.0"
	},
	"packageManager": "bun@1.3.14"
}
