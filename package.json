{
	"name": "nanahoshi-v2",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"typescript": "^6.0.3",
			"@types/bun": "^1.3.14",
			"hono": "^4.12.25",
			"@orpc/server": "^1.14.6",
			"@orpc/openapi": "^1.14.6",
			"@orpc/zod": "^1.14.6",
			"better-auth": "^1.6.18",
			"@orpc/client": "^1.14.6",
			"drizzle-orm": "^0.45.2",
			"@types/pg": "^8.20.0"
		}
	},
	"type": "module",
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"check-types": "turbo check-types",
		"dev:native": "turbo -F native dev",
		"dev:web": "turbo -F web dev",
		"dev:server": "turbo -F server dev",
		"db:push": "turbo -F @nanahoshi-v2/db db:push",
		"db:studio": "turbo -F @nanahoshi-v2/db db:studio",
		"db:generate": "turbo -F @nanahoshi-v2/db db:generate",
		"db:migrate": "turbo -F @nanahoshi-v2/db db:migrate",
		"db:start": "turbo -F @nanahoshi-v2/db db:start",
		"db:watch": "turbo -F @nanahoshi-v2/db db:watch",
		"db:stop": "turbo -F @nanahoshi-v2/db db:stop",
		"db:down": "turbo -F @nanahoshi-v2/db db:down",
		"infra:up": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env up -d",
		"infra:down": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env down",
		"infra:logs": "docker compose -f docker-compose.dev.yml --env-file apps/server/.env logs -f",
		"check": "biome check --write .",
		"test": "bun test packages/api/ apps/web/",
		"validate": "bun run check-types && bunx biome check . && bun run test"
	},
	"dependencies": {
		"@better-auth/api-key": "^1.6.18",
		"@nanahoshi-v2/env": "workspace:*",
		"better-auth": "^1.6.18",
		"dotenv": "^17.4.2",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@nanahoshi-v2/config": "workspace:*",
		"@types/bun": "^1.3.14",
		"turbo": "^2.9.18",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.1"
}
