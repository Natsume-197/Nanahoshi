## General
ENVIRONMENT=development
CORS_ORIGIN=http://localhost:3001
SERVER_URL=http://localhost:3000                          # Backend's own public URL (used to generate avatar/download links)
VITE_SERVER_URL=http://localhost:3000                     # URL the frontend uses to reach the backend API (usually same as SERVER_URL)
NAMESPACE_UUID=12345678-9012-3456-7890-123456789012
DOWNLOAD_SECRET=12345678-9012-3456-7890-123456789012
COOKIE_DOMAIN=

## Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=nanahoshi-v2
DB_PASSWORD=password

## Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=nanahoshi

## Authentication
BETTER_AUTH_SECRET=better-auth-secret-12345678901234567890
BETTER_AUTH_URL=http://localhost:3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

## Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

## Search
## SEARCH_PROVIDER: "pgroonga" (default, lightweight) or "elasticsearch" (advanced)
## When using elasticsearch, start it with: docker compose --profile elasticsearch up -d
SEARCH_PROVIDER=pgroonga
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=nanahoshi