# General
ENVIRONMENT=production
APP_PORT=7331
APP_URL=http://localhost:7331
PUID=1000
PGID=1000
NAMESPACE_UUID=                                       # REQUIRED — random UUID for stable book identifiers
DOWNLOAD_SECRET=                                      # REQUIRED — separate random UUID for download links
CORS_ORIGIN=${APP_URL}
SERVER_URL=${APP_URL}
TRUSTED_PROXY_IPS=
VITE_SERVER_URL=
COOKIE_DOMAIN=

# Authentication
BETTER_AUTH_URL=${APP_URL}
BETTER_AUTH_SECRET=                                   # REQUIRED — generate with: openssl rand -base64 32
DISCORD_CLIENT_ID=                                    # OPTIONAL — Discord sign-in
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=                                     # OPTIONAL — Google sign-in (redirect URI: ${APP_URL}/api/auth/callback/google)
GOOGLE_CLIENT_SECRET=

# Legal — what "by continuing you agree to…" links to
TERMS_URL=                                            # OPTIONAL — defaults to this server's ${APP_URL}/legal/terms
PRIVACY_URL=                                          # OPTIONAL — defaults to ${APP_URL}/legal/privacy

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_NAME=nanahoshi
DB_PASSWORD=                                          # REQUIRED — generate with: openssl rand -hex 32

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=                                       # REQUIRED — generate separately with: openssl rand -hex 32

# Email — OPTIONAL (Send to Kindle)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# PostHog — OPTIONAL
# VITE_* settings apply when building the frontend, not at Docker runtime.
VITE_POSTHOG_PROJECT_TOKEN=
VITE_POSTHOG_HOST=
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=

# Read & Listen — OPTIONAL (Honomiya)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
