# ── Nanahoshi configuration ──────────────────────────────────────────
# Copy this file to .env and fill in the values marked REQUIRED.
# Generate the secrets with the commands shown in each comment.

## General
# development | production. Docker Compose always runs the app in production
# mode regardless of this value; it matters when running from source.
ENVIRONMENT=development
# Public URL of the web app (what you type in the browser).
CORS_ORIGIN=http://localhost:3001
# Public URL of the backend API (used to generate avatar/download links).
SERVER_URL=http://localhost:3000
# URL the frontend uses to reach the backend API. Usually same as SERVER_URL.
VITE_SERVER_URL=http://localhost:3000
# REQUIRED — random UUID used to derive stable book identifiers.
# Generate with: uuidgen   (don't change it later: book UUIDs derive from it)
NAMESPACE_UUID=
# REQUIRED — random UUID that signs download links. Generate with: uuidgen
# (use a different value than NAMESPACE_UUID)
DOWNLOAD_SECRET=
# Only needed when web and API live on different subdomains of one domain.
COOKIE_DOMAIN=

## Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_NAME=nanahoshi-v2
# REQUIRED — pick a strong password. The server refuses to start in
# production with the value "password".
DB_PASSWORD=

## Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REQUIRED — pick any strong password; the Redis container is created with it.
REDIS_PASSWORD=

## Worker resource budget
# Maximum concurrent jobs/threads used by the main worker pipelines.
WORKER_CONCURRENCY=2
# Hard Docker limits for the whole worker container, including Calibre/FFmpeg.
WORKER_CPUS=2.0
WORKER_MEMORY_LIMIT=1g
WORKER_PIDS_LIMIT=128
# Scan producers pause above the high mark and resume at/below the low mark.
SCAN_QUEUE_HIGH_WATERMARK=2000
SCAN_QUEUE_LOW_WATERMARK=1000
SCAN_QUEUE_BATCH_SIZE=250
SCAN_QUEUE_POLL_MS=250

## Authentication
# REQUIRED — session signing secret, at least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Optional: enable "Sign in with Discord".
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

## Email — OPTIONAL
# Only needed for email invitations and Send to Kindle. Invite links work
# without it. Leave empty to run without email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

## Search
## SEARCH_PROVIDER: "pgroonga" (default, lightweight) or "elasticsearch" (advanced)
## When using elasticsearch, start it with: docker compose --profile elasticsearch up -d
SEARCH_PROVIDER=pgroonga
ELASTICSEARCH_NODE=http://127.0.0.1:9200
ELASTICSEARCH_INDEX_PREFIX=nanahoshi
