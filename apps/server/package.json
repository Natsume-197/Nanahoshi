{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --watch src/index.ts",
		"dev:worker": "PROCESS_ROLE=worker bun run src/worker.ts",
		"dev:worker:watch": "PROCESS_ROLE=worker bun run --watch src/worker.ts",
		"start": "bun run dist/index.mjs",
		"start:worker": "PROCESS_ROLE=worker bun run dist/worker.mjs"
	},
	"dependencies": {
		"@bull-board/api": "^9.5.0",
		"@bull-board/hono": "^9.5.0",
		"@nanahoshi-v2/api": "workspace:*",
		"@nanahoshi-v2/auth": "workspace:*",
		"@nanahoshi-v2/db": "workspace:*",
		"@nanahoshi-v2/env": "workspace:*",
		"@orpc/openapi": "^1.15.0",
		"@orpc/server": "^1.15.0",
		"@orpc/zod": "^1.15.0",
		"hono": "^4.13.5",
		"sharp": "^0.35.4"
	},
	"devDependencies": {
		"@nanahoshi-v2/config": "workspace:*",
		"@types/bun": "^1.4.0",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2"
	}
}
