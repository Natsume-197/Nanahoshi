{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --watch src/index.ts",
		"dev:worker": "PROCESS_ROLE=worker bun run --watch src/worker.ts",
		"dev:worker:stable": "PROCESS_ROLE=worker bun run src/worker.ts",
		"start": "bun run dist/index.mjs",
		"start:worker": "PROCESS_ROLE=worker bun run dist/worker.mjs"
	},
	"dependencies": {
		"@bull-board/api": "^9.10.1",
		"@bull-board/hono": "^9.10.1",
		"@nanahoshi/api": "workspace:*",
		"@nanahoshi/auth": "workspace:*",
		"@nanahoshi/db": "workspace:*",
		"@nanahoshi/env": "workspace:*",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"hono": "catalog:",
		"sharp": "^0.35.4"
	},
	"devDependencies": {
		"@nanahoshi/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
