{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@bull-board/api": "^6.21.3",
		"@bull-board/hono": "^6.21.3",
		"@nanahoshi-v2/api": "workspace:*",
		"@nanahoshi-v2/auth": "workspace:*",
		"@nanahoshi-v2/db": "workspace:*",
		"@nanahoshi-v2/env": "workspace:*",
		"@orpc/openapi": "^1.14.4",
		"@orpc/server": "^1.14.4",
		"@orpc/zod": "^1.14.4",
		"better-auth": "^1.6.14",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"hono": "^4.12.23",
		"pino": "^9.14.0",
		"sharp": "^0.34.5",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@nanahoshi-v2/config": "workspace:*",
		"@types/bun": "^1.3.14",
		"tsdown": "^0.20.3",
		"typescript": "^5.9.3"
	}
}
