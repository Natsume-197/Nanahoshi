{
	"name": "mobile",
	"private": true,
	"version": "0.1.0",
	"main": "expo-router/entry",
	"scripts": {
		"start": "bun run reader:bundle && expo start",
		"android": "bun run reader:bundle && expo run:android",
		"ios": "bun run reader:bundle && expo run:ios",
		"check-types": "node scripts/check-types.mjs",
		"apk": "bash scripts/build-apk.sh release",
		"apk:debug": "bash scripts/build-apk.sh debug",
		"reader:bundle": "bun run --cwd reader-embed build && node scripts/reader-bundle.mjs"
	},
	"dependencies": {
		"@better-auth/expo": "1.7.5",
		"@expo/ui": "~57.0.20",
