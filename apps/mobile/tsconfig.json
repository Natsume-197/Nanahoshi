{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"noUnusedLocals": true,
		"skipLibCheck": true,
		"types": ["bun", "react"],
		"paths": {
			"@/*": ["./src/*"],
			"@/assets/*": ["./assets/*"]
		}
	},
	"include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
	"exclude": ["node_modules", "reader-embed"]
}
