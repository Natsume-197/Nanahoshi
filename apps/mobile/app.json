{
	"expo": {
		"name": "Nanahoshi",
		"slug": "nanahoshi",
		"version": "0.1.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "nanahoshi",
		"userInterfaceStyle": "automatic",
		"ios": {
			"bundleIdentifier": "app.nanahoshi.mobile",
			"supportsTablet": true
		},
		"android": {
			"package": "app.nanahoshi.mobile",
			"versionCode": 1,
			"adaptiveIcon": {
				"backgroundColor": "#19191a",
				"foregroundImage": "./assets/images/adaptive-icon.png"
			},
			"softwareKeyboardLayoutMode": "resize",
			"blockedPermissions": [
				"android.permission.RECORD_AUDIO",
				"android.permission.SYSTEM_ALERT_WINDOW",
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE"
			]
		},
		"plugins": [
			"expo-router",
			"expo-secure-store",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#fbf8f5",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 96,
					"dark": {
						"backgroundColor": "#151518"
					}
				}
			],
			"expo-localization",
			[
				"expo-camera",
				{
					"cameraPermission": "Nanahoshi uses the camera only to scan the code your server shows to connect this phone.",
					"microphonePermission": false,
					"recordAudioAndroid": false
				}
			],
			[
				"expo-font",
				{
					"fonts": [
						"./assets/fonts/GenInterfaceJP-Regular.ttf",
						"./assets/fonts/GenInterfaceJP-Medium.ttf",
						"./assets/fonts/GenInterfaceJP-SemiBold.ttf",
						"./assets/fonts/GenInterfaceJP-Bold.ttf",
						"./assets/fonts/SymbolsFilled.ttf"
					]
				}
			],
			[
				"expo-audio",
				{
					"microphonePermission": false,
					"enableBackgroundPlayback": true
				}
			],
			"expo-sharing",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true,
						"enableMinifyInReleaseBuilds": true,
						"enableShrinkResourcesInReleaseBuilds": true
					}
				}
			],
			"./plugins/release-signing.js"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		}
	}
}
