{
	"include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"],
	"compilerOptions": {
		"target": "ES2022",
		"jsx": "react-jsx",
		"module": "ESNext",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["vite/client", "bun"],
		"moduleResolution": "bundler",
		"allowJs": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true
	}
}
