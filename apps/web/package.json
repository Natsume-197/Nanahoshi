{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"generate:i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --output-structure message-modules --silent",
		"generate:routes": "tsr generate",
		"generate": "bun run generate:i18n && bun run generate:routes",
		"check-types": "tsc --noEmit",
		"build": "vite build && bun run scripts/precompress-assets.ts",
		"start": "bun run server.ts",
		"test:production-ssr": "bun run scripts/verify-production-ssr.ts",
		"test:e2e:reader": "bun run scripts/reader-e2e.ts",
		"test:e2e:member-onboarding": "bun run scripts/member-onboarding-e2e.ts",
		"preview": "vite preview",
		"dev": "vite dev"
	},
