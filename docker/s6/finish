#!/bin/sh
# During an intentional shutdown s6 has already marked the service down.
if [ "$(/command/s6-svstat -o wantedup .)" = true ]; then
	echo "Nanahoshi: a required process exited; stopping the container." >&2
	echo 1 > /run/s6-linux-init-container-results/exitcode
	exec /run/s6/basedir/bin/halt
fi
